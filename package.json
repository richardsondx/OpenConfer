{
  "name": "openconfer",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Open-source human decision infrastructure for AI agents",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "setup": "bash scripts/setup.sh",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
