FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY adapters ./adapters
COPY apps/server ./apps/server
COPY apps/conversation-worker ./apps/conversation-worker
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @openconfer/server... build \
  && pnpm --filter @openconfer/conversation-worker... build \
  && pnpm --filter @openconfer/server deploy --prod --legacy /opt/server \
  && pnpm --filter @openconfer/conversation-worker deploy --prod --legacy /opt/conversation-worker

FROM node:22-bookworm-slim AS server
WORKDIR /app
COPY --from=builder /opt/server ./
COPY docker/server-entrypoint.sh /usr/local/bin/openconfer-entrypoint
RUN chmod +x /usr/local/bin/openconfer-entrypoint
EXPOSE 8787
ENTRYPOINT ["openconfer-entrypoint"]
CMD ["node", "dist/index.js"]

FROM node:22-bookworm-slim AS conversation-worker
WORKDIR /app
COPY --from=builder /opt/conversation-worker ./
CMD ["node", "dist/index.js", "start"]
